@model ReportViewModel
@{
    ViewData["Title"] = "Payroll cost by department";
    var report = Model.Report;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Payroll cost by department</h1>
    @if (report is not null && report.Rows.Count > 0)
    {
        <a asp-action="ExportCsv" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")"
           class="btn btn-outline-secondary" id="export-report">Export CSV</a>
    }
</div>

<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3" id="report-filter">
    <div class="col-md-3">
        <label for="from" class="form-label small">From</label>
        <input type="date" id="from" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-3">
        <label for="to" class="form-label small">To</label>
        <input type="date" id="to" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control" />
        <span asp-validation-for="To" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-outline-primary">Run report</button>
    </div>
</form>
<p class="small text-muted">Includes approved and paid pay runs whose period lies inside the selected range.</p>

@if (report is not null)
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0" id="report-table">
                <thead class="table-light">
                <tr>
                    <th>Department</th>
                    <th class="text-end">Employees</th>
                    <th class="text-end">Payslips</th>
                    <th class="text-end">Gross</th>
                    <th class="text-end">Income tax</th>
                    <th class="text-end">Social</th>
                    <th class="text-end">Pension</th>
                    <th class="text-end">Other</th>
                    <th class="text-end">Net</th>
                </tr>
                </thead>
                <tbody>
                @if (report.Rows.Count == 0)
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">No approved payroll in this period.</td></tr>
                }
                @foreach (var r in report.Rows)
                {
                    <tr>
                        <td>@r.Department</td>
                        <td class="text-end">@r.Employees</td>
                        <td class="text-end">@r.Payslips</td>
                        <td class="text-end"><money value="@r.Gross" /></td>
                        <td class="text-end"><money value="@r.IncomeTax" /></td>
                        <td class="text-end"><money value="@r.SocialContribution" /></td>
                        <td class="text-end"><money value="@r.Pension" /></td>
                        <td class="text-end"><money value="@r.OtherDeductions" /></td>
                        <td class="text-end"><money value="@r.Net" /></td>
                    </tr>
                }
                </tbody>
                @if (report.Rows.Count > 0)
                {
                    <tfoot class="table-light fw-semibold">
                    <tr>
                        <td>Total</td>
                        <td class="text-end">@report.TotalEmployees</td>
                        <td class="text-end">@report.TotalPayslips</td>
                        <td class="text-end"><money value="@report.TotalGross" /></td>
                        <td class="text-end"><money value="@report.TotalTax" /></td>
                        <td class="text-end"><money value="@report.TotalSocial" /></td>
                        <td class="text-end"><money value="@report.TotalPension" /></td>
                        <td class="text-end"><money value="@report.TotalOther" /></td>
                        <td class="text-end"><money value="@report.TotalNet" /></td>
                    </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
}
