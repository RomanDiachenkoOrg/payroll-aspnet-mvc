<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Acme Payroll</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole(Roles.Admin);
    var isManager = User.IsInRole(Roles.Manager);
    var hasEmployee = User.GetEmployeeId().HasValue;
}
<header class="d-print-none">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container-fluid">
            <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">Acme Payroll</a>
            @if (signedIn)
            {
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" nav-active>Dashboard</a></li>
                        @if (isAdmin || isManager)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Employees" asp-action="Index" nav-active>Employees</a></li>
                        }
                        <li class="nav-item"><a class="nav-link" asp-controller="Timesheets" asp-action="Index" nav-active>Timesheets</a></li>
                        @if (isAdmin)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="PayRuns" asp-action="Index" nav-active>Pay runs</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Departments" asp-action="Index" nav-active>Departments</a></li>
                        }
                        @if (isAdmin || isManager)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Index" nav-active>Reports</a></li>
                        }
                        @if (hasEmployee)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Payslips" asp-action="Mine" nav-active>My payslips</a></li>
                        }
                        @if (isAdmin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="adminMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">Admin</a>
                                <ul class="dropdown-menu" aria-labelledby="adminMenu">
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Settings">Tax &amp; rates</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users">Users</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="AuditLog">Audit log</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <span class="navbar-text small" id="current-user">
                            @if (hasEmployee)
                            {
                                <a class="link-light" asp-controller="Employees" asp-action="Me">@User.Identity!.Name</a>
                            }
                            else
                            {
                                @User.Identity!.Name
                            }
                            <span class="badge text-bg-secondary ms-1">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                        </span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-light btn-sm" id="logout-button">Sign out</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </nav>
</header>

<main class="container pb-5" role="main">
    <partial name="_StatusMessage" />
    @RenderBody()
</main>

<footer class="border-top py-3 text-muted small d-print-none">
    <div class="container d-flex justify-content-between">
        <span>&copy; @DateTime.Today.Year Acme Corp - Payroll &amp; HR</span>
        <span>All amounts in USD</span>
    </div>
</footer>

<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmModalTitle">Please confirm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="confirmModalBody">Are you sure?</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="confirmCancel">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmOk">Confirm</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
