@model ErrorViewModel
@{
    var title = Model.StatusCode switch
    {
        404 => "Page not found",
        403 => "Access denied",
        400 => "Bad request",
        _ => "Error"
    };
    ViewData["Title"] = title;
}

<div class="text-center py-5">
    <p class="display-4 text-muted">@Model.StatusCode</p>
    <h1 class="h3">@title</h1>
    @if (Model.StatusCode == 404)
    {
        <p>The page or record you are looking for does not exist or was removed.</p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Back to dashboard</a>
</div>
