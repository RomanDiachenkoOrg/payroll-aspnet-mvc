@model IReadOnlyList<DepartmentListItem>
@{
    ViewData["Title"] = "Departments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Departments</h1>
    <a asp-action="Create" class="btn btn-primary" id="add-department">+ New department</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="departments-table">
            <thead class="table-light">
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Cost center</th>
                <th>Description</th>
                <th class="text-end">Active employees</th>
                <th class="text-end">Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                var d = item.Department;
                <tr data-department-id="@d.Id">
                    <td><code>@d.Code</code></td>
                    <td>@d.Name</td>
                    <td>@d.CostCenter</td>
                    <td class="text-muted small">@d.Description</td>
                    <td class="text-end">
                        <a asp-controller="Employees" asp-action="Index" asp-route-departmentId="@d.Id">@item.ActiveEmployees</a>
                    </td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-1">
                            <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@d.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        data-confirm="Delete department &quot;@d.Name&quot;? This cannot be undone.">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
