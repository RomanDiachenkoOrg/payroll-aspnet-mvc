@model DepartmentFormViewModel
@{
    ViewData["Title"] = "New department";
}

<h1 class="h3 mb-3">New department</h1>
<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post" id="department-form">
            <partial name="_DepartmentForm" model="Model" />
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
