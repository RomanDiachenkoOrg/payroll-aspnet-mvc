@model SettingsViewModel
@{
    ViewData["Title"] = "Tax & rates";
}

<h1 class="h3 mb-1">Tax brackets &amp; rates</h1>
@if (Model.UpdatedAt.HasValue)
{
    <p class="small text-muted">Last changed @Model.UpdatedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") by @Model.UpdatedBy</p>
}

<form asp-action="Settings" method="post" id="settings-form">
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

    <div class="card mb-3">
        <div class="card-header">Contribution rates</div>
        <div class="card-body row g-3">
            <div class="col-md-4">
                <label asp-for="SocialContributionPercent" class="form-label"></label>
                <input asp-for="SocialContributionPercent" class="form-control" step="0.01" />
                <span asp-validation-for="SocialContributionPercent" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="PensionPercent" class="form-label"></label>
                <input asp-for="PensionPercent" class="form-control" step="0.01" />
                <span asp-validation-for="PensionPercent" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="PayDayOfMonth" class="form-label"></label>
                <input asp-for="PayDayOfMonth" class="form-control" />
                <span asp-validation-for="PayDayOfMonth" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="OvertimeMultiplier" class="form-label"></label>
                <input asp-for="OvertimeMultiplier" class="form-control" step="0.05" />
                <span asp-validation-for="OvertimeMultiplier" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="WeeklyOvertimeThreshold" class="form-label"></label>
                <input asp-for="WeeklyOvertimeThreshold" class="form-control" step="0.5" />
                <span asp-validation-for="WeeklyOvertimeThreshold" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Monthly income tax brackets</div>
        <div class="table-responsive">
            <table class="table align-middle mb-0" id="tax-brackets">
                <thead class="table-light">
                <tr><th>From (USD)</th><th>To (USD, empty = no limit)</th><th>Rate (%)</th><th class="text-center">Remove</th></tr>
                </thead>
                <tbody>
                @for (var i = 0; i < Model.Brackets.Count; i++)
                {
                    <tr>
                        <td>
                            <label asp-for="Brackets[i].LowerBound" class="visually-hidden">Bracket @(i + 1) from</label>
                            <input asp-for="Brackets[i].LowerBound" class="form-control form-control-sm" step="0.01" />
                        </td>
                        <td>
                            <label asp-for="Brackets[i].UpperBound" class="visually-hidden">Bracket @(i + 1) to</label>
                            <input asp-for="Brackets[i].UpperBound" class="form-control form-control-sm" step="0.01" />
                        </td>
                        <td>
                            <label asp-for="Brackets[i].RatePercent" class="visually-hidden">Bracket @(i + 1) rate</label>
                            <input asp-for="Brackets[i].RatePercent" class="form-control form-control-sm" step="0.01" />
                            <span asp-validation-for="Brackets[i].RatePercent" class="text-danger small"></span>
                        </td>
                        <td class="text-center">
                            <input asp-for="Brackets[i].Remove" class="form-check-input" aria-label="Remove bracket @(i + 1)" />
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="card-footer">
            <button type="submit" name="addBracket" value="1" class="btn btn-sm btn-outline-secondary" formnovalidate>+ Add bracket</button>
        </div>
    </div>

    <button type="submit" class="btn btn-primary" id="save-settings" data-confirm="Save the new payroll settings? They apply to all future calculations.">Save settings</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
