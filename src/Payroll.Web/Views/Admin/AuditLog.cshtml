@model AuditLogViewModel
@{
    ViewData["Title"] = "Audit log";
    var q = Model.Query;
    var r = Model.Result;
}

<h1 class="h3 mb-3">Audit log</h1>

<form method="get" asp-action="AuditLog" class="row g-2 align-items-end mb-3" id="audit-filter">
    <div class="col-md-3">
        <label for="userEmail" class="form-label small">User</label>
        <input type="search" id="userEmail" name="userEmail" value="@q.UserEmail" class="form-control" placeholder="email contains..." />
    </div>
    <div class="col-md-2">
        <label for="action" class="form-label small">Action</label>
        <select id="action" name="action" class="form-select">
            <option value="">Any</option>
            @foreach (var a in Model.Actions)
            {
                <option value="@a" selected="@(a == q.Action)">@a</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label for="entityType" class="form-label small">Entity</label>
        <select id="entityType" name="entityType" class="form-select">
            <option value="">Any</option>
            @foreach (var t in Model.EntityTypes)
            {
                <option value="@t" selected="@(t == q.EntityType)">@t</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label for="from" class="form-label small">From</label>
        <input type="date" id="from" name="from" value="@q.From?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-2">
        <label for="to" class="form-label small">To</label>
        <input type="date" id="to" name="to" value="@q.To?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-1">
        <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0" id="audit-table">
            <thead class="table-light">
            <tr><th>Time</th><th>User</th><th>Action</th><th>Entity</th><th>Details</th></tr>
            </thead>
            <tbody>
            @if (r.Items.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted py-4">No entries.</td></tr>
            }
            @foreach (var a in r.Items)
            {
                <tr>
                    <td class="text-nowrap">@a.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@a.UserEmail</td>
                    <td><span class="badge text-bg-light border">@a.Action</span></td>
                    <td>@a.EntityType @(a.EntityId is null ? "" : "#" + a.EntityId)</td>
                    <td class="small">@a.Details</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center">
        <span class="small text-muted">@r.TotalCount entries</span>
        <pager page="@r.Page" total-pages="@r.TotalPages" />
    </div>
</div>
