@model PayslipViewModel
@{
    Layout = null;
    var p = Model.Payslip;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Payslip - @p.Employee?.FullName - @p.PayRun?.PeriodStart.ToString("MMMM yyyy")</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="print-page">
<div class="container py-4" style="max-width: 760px">
    <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3">
        <div>
            <div class="h4 mb-0">@Model.CompanyName</div>
            <div class="small text-muted">100 Market Street, Springfield</div>
        </div>
        <div class="text-end">
            <div class="h5 mb-0">PAYSLIP</div>
            <div class="small text-muted">#@p.Id.ToString("D6")</div>
        </div>
    </div>

    <partial name="_PayslipBody" model="p" />

    <p class="small text-muted mt-4">This payslip was generated electronically and is valid without a signature. Amounts in USD.</p>
    <div class="d-print-none mt-3">
        <button type="button" class="btn btn-primary" onclick="window.print()">Print</button>
        <button type="button" class="btn btn-link" onclick="window.close()">Close</button>
    </div>
</div>
</body>
</html>
