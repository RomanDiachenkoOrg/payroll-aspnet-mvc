@model EmployeeFormViewModel
@{
    ViewData["Title"] = "Edit employee";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Employees</a></li>
        <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@Model.FirstName @Model.LastName</a></li>
        <li class="breadcrumb-item active" aria-current="page">Edit</li>
    </ol>
</nav>

<h1 class="h3 mb-3">Edit employee <small class="text-muted">@Model.EmployeeNumber</small></h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="employee-form">
            <input type="hidden" asp-for="EmployeeNumber" />
            <partial name="_EmployeeForm" model="Model" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" id="save-employee">Save changes</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
