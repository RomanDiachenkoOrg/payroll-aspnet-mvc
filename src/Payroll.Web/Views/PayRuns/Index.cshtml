@model IReadOnlyList<PayRun>
@{
    ViewData["Title"] = "Pay runs";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Pay runs</h1>
    <a asp-action="Create" class="btn btn-primary" id="new-payrun">+ New pay run</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="payruns-table">
            <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Period</th>
                <th>Pay date</th>
                <th>Status</th>
                <th class="text-end">Payslips</th>
                <th class="text-end">Gross</th>
                <th class="text-end">Net</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted py-4">No pay runs yet.</td></tr>
            }
            @foreach (var run in Model)
            {
                <tr data-payrun-id="@run.Id">
                    <td><a asp-action="Details" asp-route-id="@run.Id">@run.Name</a></td>
                    <td>@run.PeriodStart.ToString("yyyy-MM-dd") - @run.PeriodEnd.ToString("yyyy-MM-dd")</td>
                    <td>@run.PayDate.ToString("yyyy-MM-dd")</td>
                    <td><status-badge status="@run.Status" /></td>
                    <td class="text-end">@run.Payslips.Count</td>
                    <td class="text-end"><money value="@run.TotalGross" /></td>
                    <td class="text-end"><money value="@run.TotalNet" /></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
