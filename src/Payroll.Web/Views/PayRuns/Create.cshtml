@model CreatePayRunViewModel
@{
    ViewData["Title"] = "New pay run";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Pay runs</a></li>
        <li class="breadcrumb-item active" aria-current="page">New</li>
    </ol>
</nav>

<h1 class="h3 mb-3">New pay run</h1>
<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post" id="payrun-form">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label">Name (optional)</label>
                    <input asp-for="Name" class="form-control" placeholder="Payroll Month Year" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-2">
                    <label asp-for="PeriodStart" class="form-label"></label>
                    <input asp-for="PeriodStart" class="form-control" type="date" />
                    <span asp-validation-for="PeriodStart" class="text-danger small"></span>
                </div>
                <div class="col-md-2">
                    <label asp-for="PeriodEnd" class="form-label"></label>
                    <input asp-for="PeriodEnd" class="form-control" type="date" />
                    <span asp-validation-for="PeriodEnd" class="text-danger small"></span>
                </div>
                <div class="col-md-2">
                    <label asp-for="PayDate" class="form-label"></label>
                    <input asp-for="PayDate" class="form-control" type="date" />
                    <span asp-validation-for="PayDate" class="text-danger small"></span>
                </div>
            </div>
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary" id="create-payrun">Create pay run</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
